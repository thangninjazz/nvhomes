{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=nvhomedb;Username=postgres;Password=${DB_PASSWORD:-password}"
  },
  "JwtSettings": {
    "Secret": "${JWT_SECRET:-SuperSecretKeyForJWTAuth_ChangeThisInProduction!}",
    "Issuer": "NVHome",
    "Audience": "NVHomeUsers",
    "ExpiryMinutes": 1440
  },
  "ReCaptcha": {
    "SecretKey": "${RECAPTCHA_SECRET_KEY:-your_recaptcha_secret_key}"
  },
  "AllowedOrigins": [
    "https://nvhomes.vn",
    "http://localhost:3000"
  ],
  "Telegram": {
    "BotToken": "${TELEGRAM_BOT_TOKEN:-your_bot_token}",
    "ChatId": "${TELEGRAM_CHAT_ID:-your_chat_id}"
  }
}
